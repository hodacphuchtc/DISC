{
  "name": "disc",
  "version": "0.1.0",
  "private": true,
  "description": "Trắc nghiệm hành vi DISC cho học sinh và phụ huynh — chạy 100% trong trình duyệt, không backend.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/sinh-danh-sach-cache.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:structure": "node scripts/check-structure.mjs",
    "check:sast": "semgrep --config .semgrep --error --quiet .",
    "kiem": "npm run typecheck && npm run lint && npm run test && npm run check:structure && npm run check:sast"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
